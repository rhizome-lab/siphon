#!/usr/bin/env bash
# Pre-commit hook: format check and clippy

set -e

STAGED_RS="$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')"
if [ -n "$STAGED_RS" ]; then
  echo "Running rustfmt on staged files..."
  echo "$STAGED_RS" | xargs -r rustfmt --edition 2021
  echo "$STAGED_RS" | xargs -r git add --
else
  echo "No staged .rs files, skipping rustfmt."
fi

echo "Running cargo clippy..."
cargo clippy --all-targets --all-features -- -D warnings 2>/dev/null || {
    echo "  Warning: clippy check failed or not available (non-critical)"
}

echo "Pre-commit checks passed!"
